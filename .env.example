# GEMINI_API_KEY: Required for server-side Gemini AI provider calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Server-side HMAC secret for signing HTTP-only session cookies.
# Auto-generated securely in data/.session_secret if omitted in development.
SESSION_SECRET=""

# CREDENTIAL_ENCRYPTION_KEY: 32-byte hex or base64 key for AES-256-GCM encryption of stored connector tokens.
CREDENTIAL_ENCRYPTION_KEY=""

# DEVELOPER_ALLOWLIST_EMAILS: Comma-separated server-side allowlist of emails granted developer privileges upon verified auth.
DEVELOPER_ALLOWLIST_EMAILS=""

# Multi-Provider Inference Keys (configured server-side only; leave blank until provisioned)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""
XAI_API_KEY=""
AI21_API_KEY=""
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
SAMBANOVA_API_KEY=""
TOGETHER_API_KEY=""
FIREWORKS_API_KEY=""
# GITHUB_TOKEN: Historical GitHub Models endpoint retired July 30, 2026 (kept only for reference / Unsupported flag)
GITHUB_TOKEN=""
HUGGINGFACE_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
NVIDIA_API_KEY=""
DEEPINFRA_API_KEY=""
OPENROUTER_API_KEY=""
HOSTED_OSS_BASE_URL=""
HOSTED_OSS_API_KEY=""

# Optional OAuth Connectors (awaiting configuration until supplied)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional Payment Provider (Stripe) — live billing stays disabled until configured
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
