# GEMINI_API_KEY: Required for server-side Gemini AI provider calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Server-side HMAC secret for signing HTTP-only session cookies.
# Auto-generated securely in data/.session_secret if omitted in development.
SESSION_SECRET=""

# CREDENTIAL_ENCRYPTION_KEY: 32-byte hex or base64 key for AES-256-GCM encryption of stored connector tokens.
CREDENTIAL_ENCRYPTION_KEY=""

# DEVELOPER_ALLOWLIST_EMAILS: Comma-separated server-side allowlist of emails granted developer privileges upon verified auth.
DEVELOPER_ALLOWLIST_EMAILS=""

# Optional Multi-Provider Inference Keys (configured server-side only)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
HOSTED_OSS_BASE_URL=""
HOSTED_OSS_API_KEY=""

# Optional OAuth Connectors (awaiting configuration until supplied)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional Payment Provider (Stripe) — live billing stays disabled until configured
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
